rules_version = '2';

// ──────────────────────────────────────────────────────────────
// Deploy with:  firebase deploy --only firestore:rules
// Or paste into: Firebase Console → Firestore Database → Rules
//
// Public visitors may only READ the projects collection.
// Creating / updating / deleting requires an authenticated
// account (the portfolio administrator, signed in via
// Firebase Authentication Email/Password → /admin).
//
// Optional hardening: uncomment the email check in the write
// condition and replace the address with your admin email.
// ──────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    match /projects/{projectId} {
      allow read: if true;

      allow create, update, delete: if request.auth != null
        // && request.auth.token.email == 'your-admin-email@example.com'
        ;
    }

    // everything else is denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
